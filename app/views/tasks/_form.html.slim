= simple_form_for([@parent, task]) do |form|
  - if task.errors.any?
    .alert.alert-danger
      h5.alert-heading=t('views.alerts.error.title')
      ul
        - task.errors.each do |error|
          li
            = error.full_message
  = form.input :title
  = form.input :description, as: :rich_text_area
  = form.input :status, collection: localized_statuses_collection(:task, Task.statuses)
  = form.input :user_id, collection: User.all, as: :select, default: current_user
  = form.input :project_id, collection: Project.all, as: :select
  = form.button :submit, class: "btn-success"
