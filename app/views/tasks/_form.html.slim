= simple_form_for(task) do |form|
  - if task.errors.any?
    .alert.alert-danger
      h5.alert-heading=t('views.alerts.error.title')
      ul
        - task.errors.each do |error|
          li
            = error.full_message
  = form.input :title
  = form.input :description
  = form.input :user_id, collection: User.all, as: :select
  = form.input :project_id, collection: Project.all, as: :select
  = form.button :submit, class: "btn-success"
