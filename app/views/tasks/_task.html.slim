div id= dom_id(task)
  .card.mb-2.bg-light
    .card-body.px-2.py-2
      .mb-1.d-inline.w-auto
        = link_to task.title, [@parent, task], class: 'text-decoration-none h-6'
        = task_status(task)
      .float-end
        = link_to [:edit, @parent, task], class: 'btn btn-warning btn-sm mx-1' do
          = fa_icon('pen')
        = link_to [@parent, task], class: 'btn btn-outline-danger btn-sm', data: {'turbo-method'=> :delete, 'turbo-confirm' => I18n.t('views.alerts.delete_confirm', object_name: task.model_name.human, object_title: task.title)} do
          = fa_icon('trash')
      div
        = local_time_ago(task.created_at)
      div 
        span.badge.text-bg-primary.me-1
          | Мында
        span.badge.text-bg-success.me-1
          | Тегтер
        span.badge.text-bg-warning.me-1
          | Полар
      
