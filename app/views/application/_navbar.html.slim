nav.navbar.navbar-expand-lg.bg-light
  .container-fluid
    = link_to 'Autoservice', root_path, class: 'navbar-brand'
    button.navbar-toggler[type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation"]
      span.navbar-toggler-icon
  #navbarNavDropdown.collapse.navbar-collapse
    ul.navbar-nav
      li.nav-item
        = link_to t('views.tasks.title'), tasks_path, class: 'nav-link'
      li.nav-item
        = link_to t('views.projects.title'), projects_path, class: 'nav-link'
      - if current_user
        li.nav-item.dropdown
          = link_to current_user.name, '#', class: 'nav-link dropdown-toggle', role:"button", data: {'bs-toggle'=> "dropdown", "bs-display" => "static"}, aria: { expanded: true }
          ul.dropdown-menu.dropdown-menu-lg-end
            li
              a.dropdown-item[href="#"]
                | Action
            li
              a.dropdown-item[href="#"]
                | Another action
            li
              =link_to t('devise.sessions.destroy.sign_out'), destroy_user_session_path, class: 'dropdown-item', data: {'turbo-method'=> :delete}
      - else
        li.nav-item
          =link_to t('devise.sessions.new.sign_in'), new_user_session_path, class: 'nav-link'