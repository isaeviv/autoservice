= simple_form_for [@workspace, project] do |form|
  - if project.errors.any?
    .alert.alert-danger
      h5.alert-heading=t('views.alerts.error.title')
      ul
        - project.errors.each do |error|
          li
            = error.full_message
  = form.input :name
  = form.input :description, as: :rich_text_area
  = form.input :user_id, collection: User.all, as: :select
  = form.button :submit, class: "btn-success"
