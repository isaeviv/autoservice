- breadcrumb :project, @workspace, @project
h1.mb-3
  span.me-3
    = @project.name
  .float-end
    = link_to t('views.actions.edit'), [:edit, @workspace, @project], class: "btn btn-warning" 
    = link_to t('views.actions.delete'), [@workspace, @project], class: "btn btn-danger mx-1", data: {'turbo-method'=> :delete}

.mb-3
  span.badge.text-bg-primary.me-1
    | Мында
  span.badge.text-bg-success.me-1
    | Тегтер
  span.badge.text-bg-warning.me-1
    | Полар
.mb-3
  .row
    .col-lg-8.col-md-12
      .shadow.border.rounded.p-2.mb-3.project-description
        dl.row
          dt.col-sm-2= Project.human_attribute_name(:owner)
          dl.col-sm-10
            = link_to "#", class: 'mx-1' do 
              = @project.user.full_name
          dt.col-sm-2= Project.human_attribute_name(:created_at)
          dl.col-sm-10= local_time_ago(@project.created_at)
        = @project.description
    .col-lg-4.col-md-12
      .shadow.border.rounded.p-2.mb-3.project-stats
        .my-1
          b Всего задач:
          span.badge.bg-secondary.mx-1
            = @project.tasks.count
        .my-1 
          b Завершены:
          span.badge.bg-success.mx-1
            = @project.tasks.completed.count
        .my-1
          b Открыты:
          span.badge.bg-primary.mx-1
            = @project.tasks.open.count
.shadow.border.rounded.p-2
  .mb-1
    span.h4 = t('views.tasks.title')
  = render @tasks